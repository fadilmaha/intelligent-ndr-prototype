.ͼ8 .cm-gutter-lint .cm-gutterElement {padding: 0.3em;}
.ͼ8 .cm-lint-marker-error:before {content: normal;}
.ͼ8 .cm-lint-marker-error {content: url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2040%2040%22%3E%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23f87%22%20stroke%3D%22%23f43%22%20stroke-width%3D%226%22%2F%3E%3C%2Fsvg%3E');}
