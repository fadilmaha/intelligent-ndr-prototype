erial-symbols" aria-hidden="true" translate="no">format_list_bulleted</span></button></div></div><div class="ol-cm-toolbar-button-group ol-cm-toolbar-stretch"><button type="button" id="toolbar-more" class="ol-cm-toolbar-button ol-cm-toolbar-overflow-toggle ol-cm-toolbar-overflow-toggle-visible" aria-label="More editor toolbar items" aria-expanded="false" aria-controls="popover-toolbar-overflow"><span class="material-symbols" aria-hidden="true" translate="no">more_horiz</span></button></div><div class="ol-toolbar-layout-right"><div class="editor-toggle-switch" aria-label="Code and visual editor switch"><form><fieldset class="toggle-switch"><legend class="visually-hidden">Editor mode.</legend><input type="radio" name="editor" id=":r1n:" class="toggle-switch-input" value="cm6" checked=""><label for=":r1n:" class="toggle-switch-label"><span>Code</span></label><span><input type="radio" name="editor" id=":r1o:" class="toggle-switch-input" value="rich-text"><label for=":r1o:" class="toggle-switch-label"><span>Visual</span></label></span></fieldset></form></div><div class="review-mode-switcher dropdown"><button class="review-mode-switcher-toggle-button editing" aria-expanded="false" aria-label="Editing"><span class="material-symbols" aria-hidden="true" translate="no">edit</span><div class="review-mode-switcher-toggle-label">Editing</div><span class="material-symbols" aria-hidden="true" translate="no">keyboard_arrow_down</span></button><ul role="menu" x-placement="bottom-end" class="dropdown-menu-popper dropdown-menu dropdown-menu-end" aria-labelledby="" data-popper-reference-hidden="false" data-popper-escaped="false" data-popper-placement="bottom-end" style="position: fixed; inset: 0px 0px auto auto; transform: translate3d(-662.667px, 104px, 0px);"><li role="none"><a role="menuitem" aria-selected="true" data-rr-ui-dropdown-item="" class="dropdown-item active" tabindex="0" href="https://www.overleaf.com/project/6a7b21ee57e27c4f25eccb04#"><span class="material-symbols dropdow