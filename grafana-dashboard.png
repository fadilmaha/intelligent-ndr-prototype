&quot;focus-mode&quot;:{&quot;phase&quot;:&quot;release&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;Focus mode is new. Click to give feedback&quot;,&quot;url&quot;:&quot;https://forms.gle/R7w3g6La9M57LMmj8&quot;}},&quot;ai-disabled-collaborators&quot;:{&quot;phase&quot;:&quot;release&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;&quot;,&quot;url&quot;:&quot;&quot;}},&quot;themed-modals&quot;:{&quot;phase&quot;:&quot;alpha&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;&quot;,&quot;url&quot;:&quot;&quot;}},&quot;intermittent-connection-improvements&quot;:{&quot;phase&quot;:&quot;release&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;&quot;,&quot;url&quot;:&quot;&quot;}},&quot;symbol-recognition&quot;:{&quot;phase&quot;:&quot;release&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;&quot;,&quot;url&quot;:&quot;&quot;}},&quot;ai-assistant-pointer&quot;:{&quot;phase&quot;:&quot;release&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;&quot;,&quot;url&quot;:&quot;&quot;}},&quot;annual-default-trial-eligible&quot;:{&quot;phase&quot;:&quot;release&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;&quot;,&quot;url&quot;:&quot;&quot;}},&quot;plugin-dimensions&quot;:{&quot;phase&quot;:&quot;labs&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;&quot;,&quot;url&quot;:&quot;https://docs.google.com/forms/d/e/1FAIpQLSfUkioujDg3hzDX4s1ny8cv_-rcxoXEODKPefSjdSzQ35LZGQ/viewform&quot;},&quot;labsDetails&quot;:{&quot;title&quot;:&quot;Dimensions&quot;,&quot;description&quot;:&quot;Search the Dimensions database for papers to add to a project&#39;s bibliography, within Overleaf.&quot;,&quot;icon&quot;:&quot;search&quot;,&quot;surveyLink&quot;:&quot;https://docs.google.com/forms/d/e/1FAIpQLSfUkioujDg3hzDX4s1ny8cv_-rcxoXEODKPefSjdSzQ35LZGQ/viewform&quot;,&quot;successNotification&quot;:{&quot;content&quot;:&quot;&quot;,&quot;buttonLabel&quot;:&quot;&quot;,&quot;buttonUrl&quot;:&quot;&quot;},&quot;isFull&quot;:false,&quot;versionCreatedAt&quot;:&quot;2026-06-16T08:43:21.836Z&quot;}},&quot;overleaf-code&quot;:{&quot;phase&quot;:&quot;labs&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;This is a new feature that enables Python code execution. Give feedback here.&quot;,&quot;url&quot;:&quot;https://forms.gle/RSQTZWfFd5AvzZX4A&quot;},&quot;labsDetails&quot;:{&quot;title&quot;:&quot;Python script runner&quot;,&quot;description&quot;:&quot;Run Python scripts directly in your Overleaf project. Write or upload a .py file, **save outputs in your script** (e.g. plt.savefig(&#39;plot.png&#39;)), then click Run. Your files appear in the project tree, ready to include in your document. No local environment or manual uploads needed.\n\nSupported packages and examples can be found in [our documentation](https://docs.overleaf.com/accounts-and-security/overleaf-labs/live-experiments#python-script-runner)&quot;,&quot;icon&quot;:&quot;code_blocks&quot;,&quot;surveyLink&quot;:&quot;https://forms.gle/RSQTZWfFd5AvzZX4A&quot;,&quot;successNotification&quot;:{&quot;content&quot;:&quot;To get started, add a .py file to your project.&quot;,&quot;buttonLabel&quot;:&quot;&quot;,&quot;buttonUrl&quot;:&quot;&quot;},&quot;isFull&quot;:false,&quot;versionCreatedAt&quot;:&quot;2026-05-12T12:21:41.047Z&quot;}},&quot;sharing-updates&quot;:{&quot;phase&quot;:&quot;labs&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;The project sharing dialog has been updated. Click to give feedback.&quot;,&quot;url&quot;:&quot;https://forms.gle/sQee9kbXQswSStbY6&quot;},&quot;labsDetails&quot;:{&quot;title&quot;:&quot;New project sharing experience&quot;,&quot;description&quot;:&quot;The share dialog now has two steps: set up sharing in the first, and manage collaborators in the second. Viewers and reviewers can request a higher level of access to a project.&quot;,&quot;icon&quot;:&quot;screen_share&quot;,&quot;surveyLink&quot;:&quot;https://forms.gle/sQee9kbXQswSStbY6&quot;,&quot;successNotification&quot;:{&quot;content&quot;:&quot;&quot;,&quot;buttonLabel&quot;:&quot;&quot;,&quot;buttonUrl&quot;:&quot;&quot;},&quot;isFull&quot;:false,&quot;versionCreatedAt&quot;:&quot;2026-07-16T09:24:48.176Z&quot;}},&quot;command-palette&quot;:{&quot;phase&quot;:&quot;labs&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;This command palette is new. \nClick to give feedback.&quot;,&quot;url&quot;:&quot;https://forms.gle/7GDijJss8JVcPmow6&quot;},&quot;labsDetails&quot;:{&quot;title&quot;:&quot;Command palette&quot;,&quot;description&quot;:&quot;Instant access to common actions and your files, without leaving the keyboard. Press Ctrl+P on Windows or Linux, or Cmd+P on macOS to launch the command palette and search for what you want to do. &quot;,&quot;icon&quot;:&quot;screen_search_desktop&quot;,&quot;surveyLink&quot;:&quot;https://forms.gle/7GDijJss8JVcPmow6&quot;,&quot;successNotification&quot;:{&quot;content&quot;:&quot;Experiment is enabled! Refresh the page and then press Ctrl+P or Cmd+P to use the command palette&quot;,&quot;buttonLabel&quot;:&quot;&quot;,&quot;buttonUrl&quot;:&quot;&quot;},&quot;isFull&quot;:false,&quot;versionCreatedAt&quot;:&quot;2026-08-04T14:36:00.720Z&quot;}},&quot;markdown-visual&quot;:{&quot;phase&quot;:&quot;labs&quot;,&quot;badgeInfo&quot;:{&quot;tooltipText&quot;:&quot;Visual markdown editing is currently being tested. Click to give feedback.&quot;,&quot;url&quot;:&quot;https://forms.gle/AJytYXC4E4bugXxw8&quot;},&quot;labsDetails&quot;:{&quot;title&quot;:&quot;Visual Markdown Editing&quot;,&quot;description&quot;:&quot;Write in markdown, preview it visually. Create a .md file and toggle between Code and Visual to edit either as plain text or as a rendered document.&quot;,&quot;icon&quot;:&quot;markdown&quot;,&quot;surveyLink&quot;:&quot;https://forms.gle/AJytYXC4E4bugXxw8&quot;,&quot;successNotification&quot;:{&quot;content&quot;:&quot;Experiment enabled. Refresh and create a .md file to get going.&quot;,&quot;buttonLabel&q