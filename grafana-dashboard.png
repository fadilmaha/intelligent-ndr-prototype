 var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨44⁩"></div><div class="page" data-page-number="45" data-l10n-id="pdfjs-page-landmark" data-l10n-args="{&quot;page&quot;:45}" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨45⁩"></div><div class="page" data-page-number="46" data-l10n-id="pdfjs-page-landmark" data-l10n-args="{&quot;page&quot;:46}" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨46⁩"></div><div class="page" data-page-number="47" data-l10n-id="pdfjs-page-landmark" data-l10n-args="{&quot;page&quot;:47}" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨47⁩"></div><div class="page" data-page-number="48" data-l10n-id="pdfjs-page-landmark" data-l10n-args="{&quot;page&quot;:48}" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨48⁩" data-loaded="true"><div class="canvasWrapper"><canvas role="presentation" width="819" height="1161"></canvas></div><div tabindex="0" class="textLayer" data-main-rotation="0" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y));" data-listening-for-double-click="true"><span role="presentation" dir="ltr" style="left: 12.86%; top: 4.08%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.998751);">Projet de Fin d’Année</span><span role="presentation" dir="ltr" style="left: 32.14%; top: 4.08%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 67.79%; top: 4.08%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.94777);">NDR – Sécurité Réseau</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 9.01%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.03439);">7.8</span><span role="presentation" dir="ltr" style="left: 17.01%; top: 9.01%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 20.27%; top: 9.01%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.12735);">Interprétation du scénario SSH</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 13.05%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.988666);">Le scénario étudié illustre l’intérêt de la corrélation.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 15.18%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.953423);">Isolation Forest considère plusieurs paquets SSH comme inhabituels.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 17.31%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.95867);">Cependant, Zeek montre pour l’une des connexions :</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 20.17%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.974021);">— une authentification réussie ;</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 22.79%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.971611);">— une seule tentative ;</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 25.41%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.978046);">— une communication vers le port SSH 22.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 28.27%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.965107);">Par ailleurs, Suricata ne détecte aucune signature réelle d’attaque.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 30.4%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.952739);">La combinaison de ces informations permet donc de considérer que le trafic peut être</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 32.53%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.00308);">inhabituel tout en restant légitime.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 34.66%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.979853);">Cette contextualisation permet de réduire le risque de faux positifs.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 39.52%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.03439);">7.9</span><span role="presentation" dir="ltr" style="left: 17.01%; top: 39.52%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 20.27%; top: 39.52%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.15288);">Bilan du chapitre</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 43.57%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.964111);">Zeek et Suricata apportent deux sources d’information complémentaires au Machine</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 45.7%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.969085);">Learning.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 47.83%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.936219);">Zeek fournit un contexte détaillé sur les communications tandis que Suricata recherche</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 49.96%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.941115);">des signatures d’attaque connues.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 52.09%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.959927);">La corrélation de ces informations permet de transformer une simple détection d’ano-</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 54.22%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.95732);">malie en un événement mieux contextualisé.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 56.34%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.957002);">Ces résultats peuvent désormais être utilisés pour calculer un score de risque, ce qui</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 58.47%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.995245);">constitue l’objet du chapitre suivant.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 49.46%; top: 93.97%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.880772);">47</span><div class="endOfContent"></div></div><div class="annotationLayer" hidden=""></div></div><div class="page" data-page-number="49" data-l10n-id="pdfjs-page-landmark" data-l10n-args="{&quot;page&quot;:49}" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨49⁩" data-loaded="true"><div class="canvasWrapper"><canvas role="presentation" width="819" height="1161"></canvas></div><div tabindex="0" class="textLayer" data-main-rotation="0" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y));" data-listening-for-double-click="true"><span role="presentation" dir="ltr" style="left: 35.85%; top: 43.92%; font-size: calc(var(--total-scale-factor) *24.79px); font-family: sans-serif; transform: scaleX(1.19316);">CHAPITRE 8</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 51.36%; font-size: calc(var(--total-scale-factor) *24.79px); font-family: sans-serif; transform: scaleX(1.08377);">Scoring, stockage et visualisation des</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 38.71%; top: 55.76%; font-size: calc(var(--total-scale-factor) *24.79px); font-family: sans-serif; transform: scaleX(1.03799);">événements</span><div class="endOfContent"></div></div><div class="annotationLayer" hidden=""></div></div><div class="page" data-page-number="50" data-l10n-id="pdfjs-page-landmark" data-l10n-args="{&quot;page&quot;:50}" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨50⁩" data-loaded="true"><div class="canvasWrapper"><canvas role="presentation" width="819" height="1161"></canvas></div><div tabindex="0" class="textLayer" data-main-rotation="0" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y));" data-listening-for-double-click="true"><span role="presentation" dir="ltr" style="left: 12.86%; top: 4.08%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.998751);">Projet de Fin d’Année</span><span role="presentation" dir="ltr" style="left: 32.14%; top: 4.08%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 67.79%; top: 4.08%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.94777);">NDR – Sécurité Réseau</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 9.01%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.03439);">8.1</span><span role="presentation" dir="ltr" style="left: 17.01%; top: 9.01%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 20.27%; top: 9.01%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.18511);">Introduction</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 13.05%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.964849);">Après la détection des anomalies et leur enrichissement à l’aide de Zeek et Suricata,</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 15.18%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.00242);">l’étape suivante consiste à transformer les différentes informations disponibles en un</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 17.31%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.966432);">indicateur permettant de prioriser les événements.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 19.44%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.944119);">Pour cela, un mécanisme de</span><span role="presentation" dir="ltr" style="left: 39.82%; top: 19.44%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 40.48%; top: 19.44%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.953814);">Risk Scoring</span><span role="presentation" dir="ltr" style="left: 51.23%; top: 19.44%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 52%; top: 19.44%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.930927);">a été développé.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 21.57%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.921538);">Les résultats obtenus sont ensuite stockés dans PostgreSQL et visualisés dans Grafana</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 23.7%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.0063);">afin de faciliter leur exploitation.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 28.56%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.03439);">8.2</span><span role="presentation" dir="ltr" style="left: 17.01%; top: 28.56%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 20.27%; top: 28.56%; font-size: calc(var(--total-scale-factor) *17.22px); font-family: sans-serif; transform: scaleX(1.13482);">Principe du Risk Scoring</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 32.61%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.939395);">Le moteur de scoring combine plusieurs informations issues des différentes briques du</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 34.73%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.997423);">prototype.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 36.86%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.982606);">Il prend notamment en considération :</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 39.73%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.978057);">— le score d’anomalie fourni par Isolation Forest ;</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 42.35%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.959306);">— le succès ou l’échec d’une authentification SSH ;</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 44.96%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.988872);">— le nombre de tentatives d’authentification ;</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 47.58%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.953587);">— la présence éventuelle d’alertes Suricata ;</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 14.82%; top: 50.2%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.945656);">— le niveau de sévérité des alertes détectées.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 53.06%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.991233);">L’objectif est d’obtenir un indicateur synthétique compris entre 0 et 100.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 55.19%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.954494);">Les niveaux de risque définis sont les suivants :</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 29.3%; top: 58.45%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.17476);">Table 8.1</span><span role="presentation" dir="ltr" style="left: 38.87%; top: 58.45%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 39.52%; top: 58.45%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.954367);">– Classification des niveaux de risque</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 41.5%; top: 61.85%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.01888);">Score</span><span role="presentation" dir="ltr" style="left: 46.84%; top: 61.85%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 49.41%; top: 61.85%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.1057);">Niveau</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 41.5%; top: 64.28%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.880772);">0–24</span><span role="presentation" dir="ltr" style="left: 45.43%; top: 64.28%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 49.41%; top: 64.28%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.05892);">FAIBLE</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 41.5%; top: 66%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.880772);">25–49</span><span role="presentation" dir="ltr" style="left: 46.41%; top: 66%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 49.41%; top: 66%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.02754);">MOYEN</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 41.5%; top: 67.81%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.880772);">50–74</span><span role="presentation" dir="ltr" style="left: 46.41%; top: 67.81%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 49.41%; top: 67.81%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.03782);">ÉLEVÉ</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 41.5%; top: 69.53%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.880772);">75–100</span><span role="presentation" dir="ltr" style="left: 47.4%; top: 69.53%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 49.41%; top: 69.53%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.04769);">CRITIQUE</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 74.19%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.963477);">Il est important de préciser que ce score est</span><span role="presentation" dir="ltr" style="left: 53.32%; top: 74.19%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;"> </span><span role="presentation" dir="ltr" style="left: 53.98%; top: 74.19%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.11687);">heuristique</span><span role="presentation" dir="ltr" style="left: 64.95%; top: 74.19%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif;">.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 76.32%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.981486);">Ainsi, un score de 60 ne signifie pas qu’il existe 60 % de probabilité qu’une attaque</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 78.44%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.00296);">ait eu lieu.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 15.81%; top: 80.57%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.961912);">Le score sert principalement à déterminer la priorité avec laquelle un événement doit</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 12.86%; top: 82.7%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(1.01544);">être traité.</span><br role="presentation"><span role="presentation" dir="ltr" style="left: 49.46%; top: 93.97%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.880772);">49</span><div class="endOfContent"></div></div><div class="annotationLayer" hidden=""></div></div><div class="page" data-page-number="51" data-l10n-id="pdfjs-page-landmark" data-l10n-args="{&quot;page&quot;:51}" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y)); --scale-round-x: 2px; --scale-round-y: 2px;" aria-label="Page ⁨51⁩" data-loaded="true"><div class="canvasWrapper"><canvas role="presentation" width="819" height="1161"></canvas></div><div tabindex="0" class="textLayer" data-main-rotation="0" style="width: round(down, var(--total-scale-factor) * 595.276px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 841.89px, var(--scale-round-y));" data-listening-for-double-click="true"><span role="presentation" dir="ltr" style="left: 12.86%; top: 4.08%; font-size: calc(var(--total-scale-factor) *11.96px); font-family: sans-serif; transform: scaleX(0.998751);">Projet de Fin d’Année</span><span role="presentation" dir="ltr" style="left: 32.14%; top: 4.08%; font-size: calc(var(--total-scale-f