.ͼn .cm-cursor, .ͼn .cm-dropCursor {color: black;}
.ͼn.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground, .ͼn .cm-selectionBackground, .ͼn .cm-content ::selection, .ͼn .cm-searchMatch.cm-searchMatch.cm-searchMatch-selected {background: rgb(181, 213, 255);}
.ͼn.cm-focused .cm-matchingBracket, .ͼn.cm-focused .cm-nonmatchingBracket {margin: 0; outline: 1px solid rgb(192, 192, 192);}
.ͼn .cm-activeLine {background: rgba(0, 0, 0, 0.07);}
.ͼn .cm-activeLineGutter {background-color: #dcdcdc;}
.ͼn .cm-selectionMatch.cm-selectionMatch, .ͼn .cm-searchMatch.cm-searchMatch {background: rgba(250, 250, 255, 0.5); outline: 1px solid rgb(200, 200, 250); margin: 0;}
.ͼm .cm-tooltip {--font-size: 12px; --source-font-family: Lucida Console,Source Code Pro,monospace; --line-height: 1.6;}
.ͼ8 {height: 100%; text-rendering: optimizeSpeed; font-variant-numeric: slashed-zero;}
.ͼ8.cm-editor.cm-focused:not(:focus-visible) {outline: none;}
.ͼ8 .cm-panels {background-color: var(--bg-secondary-themed);}
.ͼ8 .cm-panel-bottom {border-top: 1px solid var(--border-primary-themed);}
.ͼ8 .cm-panel.cm-search label {display: inline-flex; align-items: center; font-weight: normal;}
.ͼ8 .cm-selectionLayer {z-index: -10;}
.ͼ8 .cm-gutters {border-right: none; flex-shrink: 0;}
.ͼ8 .cm-foldGutter .cm-gutterElement > span {border: 1px solid transparent; border-radius: 3px; display: inline-flex; flex-direction: column; justify-content: center; color: rgba(109, 109, 109, 0.7);}
.ͼ8 .cm-lineNumbers .cm-gutterElement {padding: 0; user-select: none;}
.ͼ8:not(.cm-focused) > .cm-scroller > .cm-cursorLayer .cm-cursor {display: block; opacity: 0.2;}
.ͼ8 .cm-cursor, .ͼ8 .cm-dropCursor {border-width: 2px; margin-left: -1px; border-left-color: inherit;}
.ͼ8 .cm-tooltip-hover {border: none;}
.ͼ8 .cm-snippetField {background: rgba(194, 193, 208, 0.09); border: 1px dotted rgba(211, 208, 235, 0.62);}
